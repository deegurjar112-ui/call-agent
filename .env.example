# ==============================================================================
# LiveKit Voice Agent Configuration
# ==============================================================================
# Copy this file to `.env.local` and fill in your API keys.
# All services below offer FREE tier / trial credits.
# ==============================================================================

# 1. LiveKit Cloud (Free 10,000 mins/mo at https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# 2. OpenAI API Key (Brain / LLM - https://platform.openai.com)
OPENAI_API_KEY=sk-proj-your_openai_api_key

# 3. Deepgram API Key (Ears / STT - $200 free credit at https://deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# 4. Cartesia API Key (Ultra-fast Voice / TTS - https://cartesia.ai)
# (Optional if using ElevenLabs or OpenAI TTS)
CARTESIA_API_KEY=your_cartesia_api_key

# 5. ElevenLabs API Key (Alternative Voice - https://elevenlabs.io)
# (Optional if using Cartesia)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
